# Java API
SERVER_PORT=8080
DATABASE_URL=jdbc:h2:file:./data/finflow;MODE=PostgreSQL;AUTO_SERVER=TRUE
DATABASE_USERNAME=sa
DATABASE_PASSWORD=

# Workspace login. Only the default account is part of source control.
FINFLOW_AUTH_DEFAULT_USERNAME=default
FINFLOW_AUTH_DEFAULT_PASSWORD=Pr0d1234
# Optional private file containing test1 through test100 as username=password.
FINFLOW_AUTH_ACCOUNTS_FILE=
FINFLOW_AUTH_JWT_SECRET=change-this-session-secret

# Example project data source. This is separate from the Java service database above.
FINFLOW_DEMO_DATABASE_URL=jdbc:postgresql://127.0.0.1:5432/finflow
FINFLOW_DEMO_DATABASE_USERNAME=finflow
FINFLOW_DEMO_DATABASE_PASSWORD=finflow
FINFLOW_NVIDIA_API_URL=http://127.0.0.1:8011/api/v1/companies/nvidia/five-year-financials
FINFLOW_GLOBAL_TAX_API_URL=http://127.0.0.1:8011/api/v1/tax/2026-policy-trends
WORKER_BASE_URL=http://localhost:8001
# Per-task DuckDB memory budget. The worker also adapts thread count to the host CPU.
FINFLOW_DUCKDB_MEMORY_MB=2048
# Maximum number of dependency-independent workflow nodes executed at the same time.
FINFLOW_WORKFLOW_MAX_PARALLEL_NODES=4
FINFLOW_STORAGE_PROVIDER=local
FINFLOW_STORAGE_ROOT=./data/storage
FINFLOW_STORAGE_CACHE_ROOT=./data/blob-cache
MINIO_ROOT_USER=finflow
MINIO_ROOT_PASSWORD=finflow-storage-secret
ONLYOFFICE_JWT_SECRET=finflow-office-secret
ONLYOFFICE_MAX_DOWNLOAD_BYTES=314572800
ONLYOFFICE_XLSX_UNCOMPRESSED_LIMIT=1GB
ONLYOFFICE_NGINX_BODY_SIZE=320m
FINFLOW_OFFICE_MAX_EDITOR_FILE_BYTES=314572800

# Browser-visible Office route. The default is proxied by the Studio frontend,
# so it works unchanged on localhost, a remote IP, or an HTTPS domain.
# Set an absolute URL only when ONLYOFFICE is deployed behind its own gateway.
FINFLOW_OFFICE_DOCUMENT_SERVER_URL=/office

# LLM analysis: Codex through the OpenAI Responses API
FINFLOW_LLM_PROVIDER=codex
# Optional search against a managed LightRAG index of FinFlow source IDs and original text.
FINFLOW_TACIT_LIGHTRAG_URL=
FINFLOW_TACIT_LIGHTRAG_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-5.6-sol
OPENAI_REASONING_EFFORT=medium
OPENAI_MAX_OUTPUT_TOKENS=4000
LLM_MAX_ATTEMPTS=2
LLM_RETRY_BASE_SECONDS=1
FINFLOW_AGENT_ENABLED=true
FINFLOW_AGENT_SKILLS_DIR=skills
AGENT_MAX_TOOL_CALLS=80
AGENT_TASK_TIMEOUT_SECONDS=900
# Local: codex-cli. Company: opencode (provision approved CLI + provider config).
# This selects the task harness, independently of FINFLOW_LLM_PROVIDER.
AGENT_RUNTIME=codex-cli
OPENCODE_CLI_PATH=opencode
OPENCODE_MODEL=
OPENCODE_PROVIDER_CONFIG=
# Governed public-web search. Docker Compose uses the internal service address;
# local development uses http://127.0.0.1:8888.
RESEARCH_SEARCH_PROVIDER=searxng
RESEARCH_SEARXNG_URL=http://127.0.0.1:8888
# Comma-separated SearxNG engine pool. Partial engine outages are tolerated.
RESEARCH_SEARXNG_ENGINES=sogou,bing,baidu,brave,duckduckgo
RESEARCH_SEARCH_CONNECT_TIMEOUT_SECONDS=5
RESEARCH_SEARCH_TIMEOUT_SECONDS=15
SEARXNG_VERSION=2026.9.25-12f8b6515
SEARXNG_IMAGE=ghcr.io/searxng/searxng
SEARXNG_HOST_PORT=8888
SEARXNG_SECRET=replace-with-a-random-secret
# Shared outbound proxy for the local Worker/LLM adapter. When omitted, local
# startup reuses Docker's configured proxy and converts its host name for macOS.
FINFLOW_OUTBOUND_PROXY=
# Optional for deployments whose containers need an outbound proxy.
# Example: http://host.docker.internal:7892
SEARXNG_OUTBOUND_PROXY=
# Optional comma-separated host allowlist, for example: sec.gov,nvidia.com
RESEARCH_ALLOWED_DOMAINS=
RESEARCH_MAX_DOWNLOAD_BYTES=10485760
# Optional deployment-owned MCP configuration. Never point this at a file uploaded by a user.
FINFLOW_AGENT_MCP_CONFIG=
# Comma-separated read-only MCP tool names exposed to the planning agent.
FINFLOW_AGENT_MCP_ALLOWED_TOOLS=

# Local desktop alternative: reuse the signed-in Codex CLI (not available in containers)
# FINFLOW_LLM_PROVIDER=codex-cli
# CODEX_CLI_PATH=/Applications/ChatGPT.app/Contents/Resources/codex
# Leave empty to inherit the desktop Codex default model, or set an explicit model.
# CODEX_CLI_MODEL=
# CODEX_CLI_REASONING_EFFORT=low
# CODEX_CLI_FORCE_HTTP=false

# Optional DeepSeek fallback provider
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_CHAT_MODEL=deepseek-v4-flash

# Frontend
VITE_API_BASE_URL=http://localhost:8080

# Optional isolated browser runner. Never expose its token or browser debug port publicly.
BROWSER_RUNNER_ENABLED=false
BROWSER_RUNNER_URL=http://127.0.0.1:8002
BROWSER_RUNNER_TOKEN=
BROWSER_EXECUTABLE_PATH=
# Local single-user login takeover only; keep false on shared/remote deployments.
BROWSER_INTERACTIVE_HEADED=false
BROWSER_SITES_JSON='{}'
BROWSER_DEMO_ENABLED=false
# Browser-use exploration is optional and must run in a separate sandbox with egress controls.
# New website tasks use the independent browser-use A2A agent (no legacy fallback).
BROWSER_AGENT_URL=http://127.0.0.1:8003
BROWSER_AGENT_ENABLED=false
BROWSER_AGENT_TOKEN=
# Keep history private; profiles are removed when a task ends.
BROWSER_AGENT_DATA_DIR=.local-runtime/browser-agent
# Deprecated optional export-only exploration; not the new agent entrypoint.
BROWSER_USE_SANDBOXED=0
BROWSER_MODEL_NAME=deepseek-v4-flash
BROWSER_MODEL_BASE_URL=https://api.deepseek.com
BROWSER_MODEL_API_KEY=
