# Java API
SERVER_PORT=8080
DATABASE_URL=jdbc:h2:file:./data/finflow;MODE=PostgreSQL;AUTO_SERVER=TRUE
DATABASE_USERNAME=sa
DATABASE_PASSWORD=
WORKER_BASE_URL=http://localhost:8001
FINFLOW_STORAGE_PROVIDER=local
FINFLOW_STORAGE_ROOT=./data/storage
FINFLOW_STORAGE_CACHE_ROOT=./data/blob-cache
MINIO_ROOT_USER=finflow
MINIO_ROOT_PASSWORD=finflow-storage-secret
ONLYOFFICE_JWT_SECRET=finflow-office-secret

# Browser-visible service URLs. For remote Docker deployment, replace
# localhost with the server IP or an HTTPS domain reachable by the browser.
FINFLOW_OFFICE_DOCUMENT_SERVER_URL=http://localhost:8082

# LLM analysis: Codex through the OpenAI Responses API
FINFLOW_LLM_PROVIDER=codex
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-5.6-sol
OPENAI_REASONING_EFFORT=medium
OPENAI_MAX_OUTPUT_TOKENS=4000

# Local desktop alternative: reuse the signed-in Codex CLI (not available in containers)
# FINFLOW_LLM_PROVIDER=codex-cli
# CODEX_CLI_PATH=/Applications/ChatGPT.app/Contents/Resources/codex
# CODEX_CLI_MODEL=gpt-5.6-sol
# CODEX_CLI_REASONING_EFFORT=low
# CODEX_CLI_FORCE_HTTP=true

# Optional DeepSeek fallback provider
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_CHAT_MODEL=deepseek-v4-flash

# Frontend
VITE_API_BASE_URL=http://localhost:8080
