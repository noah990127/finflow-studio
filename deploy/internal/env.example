# Copy to deploy/internal/.env and replace every CHANGE_ME value.
FINFLOW_AUTH_DEFAULT_USERNAME=admin
FINFLOW_AUTH_DEFAULT_PASSWORD=CHANGE_ME_LOGIN_PASSWORD
FINFLOW_AUTH_JWT_SECRET=CHANGE_ME_RANDOM_64_HEX
# true behind an HTTPS gateway; false only while using an SSH localhost tunnel.
FINFLOW_AUTH_SECURE_COOKIE=true
DATABASE_PASSWORD=CHANGE_ME_DATABASE_PASSWORD
MINIO_ROOT_USER=finflow
MINIO_ROOT_PASSWORD=CHANGE_ME_STORAGE_PASSWORD
ONLYOFFICE_JWT_SECRET=CHANGE_ME_OFFICE_SECRET
ONLYOFFICE_PLATFORM=linux/amd64
FRONTEND_PORT=5173

# Preloaded view/PPT import does not call a model or require an Agent CLI.
# The live fixed workflow uses this API; use your organization's approved model.
FINFLOW_LLM_PROVIDER=codex
OPENAI_BASE_URL=https://model-gateway.example.internal/v1
OPENAI_API_KEY=
OPENAI_MODEL=REPLACE_WITH_APPROVED_MODEL
OPENAI_REASONING_EFFORT=medium
OPENAI_MAX_OUTPUT_TOKENS=16000

# Natural-language Agent authoring additionally needs a preinstalled CLI in the worker.
AGENT_ENABLED=false
AGENT_RUNTIME=opencode
OPENCODE_CLI_PATH=opencode
OPENCODE_MODEL=
OPENCODE_PROVIDER_CONFIG=
PIP_INDEX_URL=https://pypi.org/simple
SEARXNG_SECRET=CHANGE_ME_SEARCH_SECRET
