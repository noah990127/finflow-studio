# Build from repository root: docker build -f deploy/internal/Dockerfile.worker .
FROM python:3.12-slim
WORKDIR /app
ARG PIP_INDEX_URL=https://pypi.org/simple
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl ca-certificates fonts-noto-cjk fonts-wqy-zenhei \
    libreoffice-core libreoffice-writer libreoffice-calc libreoffice-impress poppler-utils \
    && rm -rf /var/lib/apt/lists/*
RUN useradd --system --uid 10001 --create-home --home-dir /home/finflow finflow
COPY worker-python/pyproject.toml ./
COPY worker-python/app ./app
COPY worker-python/skills ./skills
ENV PLAYWRIGHT_BROWSERS_PATH=/opt/playwright
# Browser/PPT rendering requires the optional browser dependency; Excel profiling uses pytz.
RUN pip install --no-cache-dir --index-url "$PIP_INDEX_URL" '.[browser]' 'pytz==2025.2' \
    && python -m playwright install --with-deps --only-shell chromium \
    && mkdir -p /app/models && chown -R finflow:finflow /app/models \
    && rm -rf /var/lib/apt/lists/*
USER finflow
EXPOSE 8001
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8001"]
